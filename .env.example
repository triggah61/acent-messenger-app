# Environment Variables Template

# API Configuration
BASE_API_URL=http://your-api-url:8000/api
AWS_S3_URL=https://your-bucket.s3.region.amazonaws.com

# Pusher Configuration
PUSHER_KEY=your_pusher_key_here
PUSHER_CLUSTER=your_cluster_here
PUSHER_USE_TLS=true

# Firebase Configuration - Web
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_WEB_APP_ID=your_firebase_web_app_id
FIREBASE_WEB_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_WEB_PROJECT_ID=your_project_id
FIREBASE_WEB_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_WEB_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_WEB_MEASUREMENT_ID=your_measurement_id

# Firebase Configuration - Android
FIREBASE_ANDROID_API_KEY=your_firebase_android_api_key
FIREBASE_ANDROID_APP_ID=your_firebase_android_app_id

# Firebase Configuration - iOS
FIREBASE_IOS_API_KEY=your_firebase_ios_api_key
FIREBASE_IOS_APP_ID=your_firebase_ios_app_id
FIREBASE_IOS_CLIENT_ID=your_ios_client_id
FIREBASE_IOS_BUNDLE_ID=com.example.acent_messenger

# Firebase Configuration - macOS (usually same as iOS)
FIREBASE_MACOS_API_KEY=your_firebase_macos_api_key
FIREBASE_MACOS_APP_ID=your_firebase_macos_app_id
FIREBASE_MACOS_CLIENT_ID=your_macos_client_id
FIREBASE_MACOS_BUNDLE_ID=com.example.acent_messenger
